---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="CV" description="Vardan Torosyan — CV">
  <div class="cv">
    <header class="cv-header">
      <h1 class="cv-name">Vardan Torosyan</h1>
      <p class="cv-tagline">Senior Engineering Manager · Berlin</p>
      <div class="cv-contact">
        <a href="mailto:vardants@gmail.com">vardants@gmail.com</a>
        <a href="https://de.linkedin.com/in/vtorosyan">LinkedIn</a>
        <a href="https://github.com/vtorosyan">GitHub</a>
        <a href="/">Blog</a>
      </div>
    </header>

    <section class="cv-section">
      <h2 class="cv-section-title">Profile</h2>
      <p class="cv-profile">
        Senior Engineering Manager with over 15 years in software engineering, including 7+ years in engineering leadership roles.
        At Grafana Labs, I've led teams through complex transitions — from multi-team mergers to org design shifts and roadmap resets — while maintaining performance and clarity.
        I focus on making principled decisions, mentoring new leaders, and creating grounded, resilient teams.
        My leadership philosophy: build trust, move with intention, and do the right thing — even when it's hard.
      </p>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Experience</h2>

      <div class="cv-job">
        <div class="cv-job-header">
          <span class="cv-company">Grafana Labs <span class="cv-location">· Remote, Berlin</span></span>
          <span class="cv-dates">Dec 2020 – Present</span>
        </div>
        <div class="cv-subrole">
          <div class="cv-role-header">
            <span class="cv-role">Senior Engineering Manager</span>
          </div>
          <p class="cv-desc">
            Built and led the Authentication and Authorization function at Grafana Labs, growing it from zero to a cross-functional org owning core auth systems across all Grafana products. Started with no team, bootstrapped engineering efforts hands-on, and scaled up to a 15-person org across multiple squads, delivering mission-critical features such as Role-Based Access Control (RBAC), Unified SSO, and identity primitives for machine authentication.
          </p>
          <p class="cv-achievements-label">Key achievements</p>
          <ul>
            <li>Joined as a manager without a team; onboarded as an engineer to identify problems and build trust.</li>
            <li>Hired and grew the team to 8 engineers in the first year, later scaling to a 15-person org with PM, UX, Docs, and embedded security engineers.</li>
            <li>Designed and shipped the initial RBAC system in 2 months with 2 engineers, previewed at GrafanaCon, and still in production 5 years later.</li>
            <li>Proposed and created the Grafana AuthNZ team to consolidate fragmented auth efforts across product areas.</li>
            <li>Unified 3 platform teams under one Identity and Access group, aligning technical direction and team strategy.</li>
            <li>Split the org into two squads and mentored a senior engineer through transition to EM.</li>
            <li>Introduced RFC-driven decision making and strong documentation culture through team wiki.</li>
            <li>Facilitated workshops and internal trainings on unconscious bias, performance, and communication.</li>
          </ul>
        </div>
      </div>

      <div class="cv-job">
        <div class="cv-job-header">
          <span class="cv-company">SoundCloud <span class="cv-location">· Berlin</span></span>
          <span class="cv-dates">Mar 2017 – Nov 2020</span>
        </div>
        <div class="cv-subrole">
          <div class="cv-role-header">
            <span class="cv-role">Engineering Manager, Data Platform</span>
            <span class="cv-role-dates">Feb 2020 – Nov 2020</span>
          </div>
          <p class="cv-desc">Managed the Data Platform team, enabling self-serve access to data across the company. Focused on coaching, mentoring, and creating space for engineers to grow and lead.</p>
        </div>
        <div class="cv-subrole">
          <div class="cv-role-header">
            <span class="cv-role">Senior Data Engineer</span>
            <span class="cv-role-dates">Aug 2019 – Jan 2020</span>
          </div>
          <p class="cv-desc">Migrated SoundCloud's data infrastructure from AWS to Google Cloud Platform. Led development of publishing and monitoring pipelines to improve visibility and reliability.</p>
        </div>
        <div class="cv-subrole">
          <div class="cv-role-header">
            <span class="cv-role">Senior Software Engineer</span>
            <span class="cv-role-dates">Mar 2017 – Jul 2019</span>
          </div>
          <p class="cv-desc">Backend engineer in the Creators team, focused on analytics features for artists. Designed and built the Stats product, helping creators understand performance and make informed decisions.</p>
          <p class="cv-stack">Scala, Java, Spark, Hadoop, GCP, AWS, Kubernetes, Airflow, MySQL, Cassandra, Kafka</p>
        </div>
      </div>

      <div class="cv-job">
        <div class="cv-job-header">
          <span class="cv-company">Friendsurance <span class="cv-location">· Berlin</span></span>
          <span class="cv-dates">Nov 2013 – Feb 2017</span>
        </div>
        <div class="cv-subrole">
          <div class="cv-role-header">
            <span class="cv-role">Team Lead</span>
            <span class="cv-role-dates">Jun 2015 – Feb 2017</span>
          </div>
          <p class="cv-desc">Started and grew a mobile engineering team for iOS and Android apps. Introduced hiring practices, scaled the team to five, and led the design of the Public API for external and internal use.</p>
        </div>
        <div class="cv-subrole">
          <div class="cv-role-header">
            <span class="cv-role">Senior Software Engineer</span>
            <span class="cv-role-dates">Nov 2013 – May 2015</span>
          </div>
          <p class="cv-desc">One of the early engineers at the company. Led multiple projects end-to-end, including the internal ticketing system for customer support. Reduced manual workflows and improved team efficiency.</p>
          <p class="cv-stack">Java, AngularJS, TypeScript, AWS, PostgreSQL, Spring, Hibernate, Ansible, Docker</p>
        </div>
      </div>

      <div class="cv-job">
        <div class="cv-job-header">
          <span class="cv-company">Essential Solution Ltd. <span class="cv-location">· Yerevan</span></span>
          <span class="cv-dates">Jun 2012 – Oct 2013</span>
        </div>
        <div class="cv-subrole">
          <div class="cv-role-header">
            <span class="cv-role">Software Engineer</span>
          </div>
          <p class="cv-desc">Built core features of the RollUp Media platform as the first engineer. Scaled the team to 7, onboarded engineers, and enabled independent contributions.</p>
          <p class="cv-stack">Java, JSF, AWS, Docker, Jenkins, MySQL, Spring, Hibernate</p>
        </div>
      </div>

      <div class="cv-job">
        <div class="cv-job-header">
          <span class="cv-company">be2 Ltd. <span class="cv-location">· Yerevan</span></span>
          <span class="cv-dates">Jun 2008 – Jun 2010</span>
        </div>
        <div class="cv-subrole">
          <div class="cv-role-header">
            <span class="cv-role">Junior Software Engineer</span>
          </div>
          <p class="cv-desc">Worked on the Payments team, implementing and integrating payment providers including GlobalCollect, HeidelPay, ClickAndBuy, and Adyen. Improved test coverage and product stability.</p>
          <p class="cv-stack">Java, JSF, EJB, Spring, Jenkins, MySQL, Hibernate</p>
        </div>
      </div>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Skills</h2>
      <dl class="cv-skills">
        <div class="cv-skill-group">
          <dt>Languages</dt>
          <dd>Go, Java, Scala, TypeScript</dd>
        </div>
        <div class="cv-skill-group">
          <dt>Cloud & Infrastructure</dt>
          <dd>AWS, GCP, Kubernetes, Docker</dd>
        </div>
        <div class="cv-skill-group">
          <dt>Data</dt>
          <dd>Kafka, Airflow, MySQL, PostgreSQL, Cassandra</dd>
        </div>
        <div class="cv-skill-group">
          <dt>IAM</dt>
          <dd>OAuth, SAML, SCIM, JWT, LDAP, RBAC</dd>
        </div>
      </dl>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Education</h2>
      <p class="cv-item">
        <strong>State Engineering University of Armenia</strong><br />
        Bachelor's in Information Systems, Sep 2006 – Jun 2010
      </p>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Courses & training</h2>
      <p class="cv-item"><strong>Business Communication Booster</strong> — American University of Armenia, Sep–Dec 2009</p>
      <p class="cv-item"><strong>Scrum Training and Coaching</strong> — agile42 GmbH, Jun–Jul 2009</p>
      <p class="cv-item"><strong>Web Development</strong> (J2SE, J2EE, PHP, SQL, OOP) — Lycos Armenia, Sep 2007 – May 2008</p>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Languages</h2>
      <p class="cv-item">English · fluent &nbsp;&nbsp; Russian · fluent &nbsp;&nbsp; German · intermediate &nbsp;&nbsp; Armenian · native</p>
    </section>

    <div class="cv-footer">
      <a href="/VardanTorosyan2025.pdf">Download as PDF</a>
    </div>
  </div>
</BaseLayout>

<style>
  .cv-header {
    padding-bottom: 1.4rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .cv-name {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin: 0 0 0.2rem;
    line-height: 1.1;
  }
  .cv-tagline {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    font-size: 0.85rem;
  }
  .cv-section { margin-bottom: 2rem; }
  .cv-section-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
    margin: 0 0 1.2rem;
  }
  .cv-profile { font-size: 0.95rem; margin: 0; }
  .cv-job { margin-bottom: 2rem; }
  .cv-job:last-child { margin-bottom: 0; }
  .cv-job-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.15rem;
  }
  .cv-company { font-weight: 600; font-size: 1rem; }
  .cv-location { font-size: 0.82rem; color: var(--muted); font-weight: 400; }
  .cv-dates { font-size: 0.8rem; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .cv-subrole { margin-bottom: 0.9rem; }
  .cv-subrole:last-child { margin-bottom: 0; }
  .cv-role-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .cv-role { font-size: 0.9rem; font-style: italic; color: var(--fg); }
  .cv-role-dates { font-size: 0.8rem; color: var(--muted); white-space: nowrap; }
  .cv-desc { font-size: 0.92rem; margin: 0 0 0.5rem; }
  .cv-job ul { margin: 0 0 0.5rem; padding-left: 1.1rem; }
  .cv-job li { font-size: 0.92rem; margin-bottom: 0.3rem; line-height: 1.6; }
  .cv-stack { font-size: 0.78rem; color: var(--muted); margin: 0.3rem 0 0; }
  .cv-achievements-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0.6rem 0 0.3rem;
  }
  .cv-skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.9rem;
  }
  .cv-skill-group dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  .cv-skill-group dd { font-size: 0.9rem; margin: 0; line-height: 1.55; }
  .cv-item { font-size: 0.92rem; margin-bottom: 0.4rem; line-height: 1.5; }
  .cv-footer {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  @media print {
    .site-header, .site-footer, .cv-footer { display: none !important; }
  }
  @media (max-width: 560px) {
    .cv-name { font-size: 1.5rem; }
    .cv-job-header, .cv-role-header { flex-direction: column; gap: 0.1rem; }
    .cv-skills { grid-template-columns: 1fr 1fr; }
  }
</style>
